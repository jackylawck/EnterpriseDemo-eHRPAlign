{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jackylawck.github.io/EnterpriseDemo-eHRPAlign/schemas/ehrp_payload_schema.json",
  "title": "eHRP Align Clean Payload Schema",
  "description": "Deterministic schema specification for normalized onboarding payloads generated by eHRP Align.",
  "type": "object",
  "required": [
    "header",
    "particulars",
    "address",
    "employment",
    "salary",
    "education",
    "prof_cert",
    "next_of_kin",
    "prev_employment"
  ],
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "employee_no": { "type": "string", "description": "Uppercase employee identifier" }
      },
      "required": ["employee_no"]
    },
    "particulars": {
      "type": "object",
      "properties": {
        "given_name": { "type": "string" },
        "surname": { "type": "string" },
        "name_on_id": { "type": "string", "description": "Full uppercase legal name verified against ID copy" },
        "given_name_secondary": { "type": "string", "description": "Chinese given name" },
        "surname_secondary": { "type": "string", "description": "Chinese surname" },
        "id_type": { "type": "string", "default": "LOCAL/PR" },
        "id_no": { "type": "string" },
        "alias": { "type": "string" },
        "gender": { "type": "string", "enum": ["M", "F", "MALE", "FEMALE", ""] },
        "date_of_birth": { "type": "string", "pattern": "^(\\d{2}/\\d{2}/\\d{2}|)$", "description": "DD/MM/YY" },
        "marital_status": { "type": "string" },
        "nationality": { "type": "string", "default": "HONG KONG SAR" },
        "race": { "type": "string" },
        "country_of_birth": { "type": "string", "default": "HONG KONG SAR" },
        "religion": { "type": "string" },
        "telephone_home": { "type": "string", "pattern": "^[0-9]*$" },
        "telephone_mobile": { "type": "string", "pattern": "^[0-9]*$", "description": "Grounded on Demo-Form-001" },
        "secondary_contact": { "type": "string" },
        "employment_status": { "type": "string", "default": "ACTIVE" },
        "probation_months": { "type": "string", "default": "3" }
      },
      "required": ["given_name", "surname", "name_on_id", "id_no", "telephone_mobile"]
    },
    "address": {
      "type": "object",
      "properties": {
        "address_line_1": { "type": "string" },
        "address_line_2": { "type": "string" },
        "address_line_3": { "type": "string" },
        "f_post_code": { "type": "string" }
      }
    },
    "employment": {
      "type": "object",
      "properties": {
        "designation": { "type": "string" },
        "effective_date_designation": { "type": "string", "pattern": "^(\\d{2}/\\d{2}/\\d{2}|)$" },
        "department": {
          "type": "string",
          "enum": ["HQ", "ENG", "OPS", "HR", "FIN", "IT", "LEGAL", ""],
          "description": "Normalized enterprise department code"
        },
        "employee_type": { "type": "string", "default": "EMPLOYEES" },
        "staff_group": { "type": "string" },
        "employee_class": { "type": "string" },
        "employment_scheme": { "type": "string", "default": "SALARY" },
        "position": { "type": "string" },
        "commencement_date": { "type": "string", "pattern": "^(\\d{2}/\\d{2}/\\d{2}|)$" },
        "cessation_date": { "type": "string", "pattern": "^(\\d{2}/\\d{2}/\\d{2}|)$" },
        "confirmation_date": { "type": "string", "pattern": "^(\\d{2}/\\d{2}/\\d{2}|)$" },
        "bank": {
          "type": "string",
          "enum": ["HSBC", "HANG SENG", "BOC", "SCB", "CITIBANK", "BEA", "DBS", ""],
          "description": "Normalized standard bank identifier"
        },
        "account_no": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "salary": {
      "type": "object",
      "properties": {
        "salary": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "variable_salary": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "daily_rate": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "add_rate": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
        "rank": { "type": "string" },
        "grade": { "type": "string" },
        "point": { "type": "string" },
        "effective_date": { "type": "string", "pattern": "^(\\d{2}/\\d{2}/\\d{2}|)$" }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "qualifications": { "type": "string" },
          "major_in": { "type": "string" },
          "institution": { "type": "string" },
          "year_grad": { "type": "string" }
        }
      }
    },
    "prof_cert": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cert_name": { "type": "string" },
          "institution": { "type": "string" },
          "year_obtain": { "type": "string" }
        }
      }
    },
    "next_of_kin": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relationship": { "type": "string" },
          "surname": { "type": "string" },
          "given_name": { "type": "string" },
          "pri_contact": { "type": "string" }
        }
      }
    },
    "prev_employment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": { "type": "string" },
          "date_join": { "type": "string" },
          "date_left": { "type": "string" },
          "designation": { "type": "string" },
          "last_drawn": { "type": "string" }
        }
      }
    }
  }
}
